import re
from collections import OrderedDict

def extract_view_metadata(sql_text: str):
    """
    Handles:
    1. CREATE OR REPLACE FORCE VIEW ... (cols) ... AS SELECT ...
    2. INSERT INTO table_name (cols) SELECT ...

    Returns:
    - target_name
    - ordered column dict {1: col1, 2: col2, ...}
    - SELECT statement (verbatim)
    """

    sql = sql_text.strip()

    # -------------------------------------------------
    # CASE 1: CREATE VIEW
    # -------------------------------------------------
    create_view_match = re.search(
        r"""
        CREATE\s+(?:OR\s+REPLACE\s+)?      # CREATE OR REPLACE
        FORCE\s+VIEW\s+
        ([A-Za-z0-9_.]+)                  # view name
        """,
        sql,
        re.IGNORECASE | re.VERBOSE
    )

    if create_view_match:
        target_name = create_view_match.group(1)

        # Column list
        column_block_match = re.search(
            r"""
            VIEW\s+[A-Za-z0-9_.]+\s*
            \(
                ([^)]*)
            \)
            """,
            sql,
            re.IGNORECASE | re.VERBOSE | re.DOTALL
        )

        if not column_block_match:
            raise ValueError("Column list not found in CREATE VIEW")

        columns = [
            col.strip()
            for col in column_block_match.group(1).split(",")
            if col.strip()
        ]

        column_dict = OrderedDict(
            (i + 1, col) for i, col in enumerate(columns)
        )

        # SELECT after AS
        as_match = re.search(
            r"""
            \bAS\b
            (.*)$
            """,
            sql,
            re.IGNORECASE | re.DOTALL | re.VERBOSE
        )

        if not as_match:
            raise ValueError("AS SELECT clause not found in CREATE VIEW")

        select_statement = as_match.group(1).strip()

        return target_name, column_dict, select_statement

    # -------------------------------------------------
    # CASE 2: INSERT INTO
    # -------------------------------------------------
    insert_match = re.search(
        r"""
        INSERT\s+INTO\s+
        ([A-Za-z0-9_.]+)                  # table name
        \s*
        \(
            ([^)]*)
        \)
        """,
        sql,
        re.IGNORECASE | re.VERBOSE | re.DOTALL
    )

    if insert_match:
        target_name = insert_match.group(1)

        columns = [
            col.strip()
            for col in insert_match.group(2).split(",")
            if col.strip()
        ]

        column_dict = OrderedDict(
            (i + 1, col) for i, col in enumerate(columns)
        )

        # SELECT statement starts from SELECT keyword
        select_match = re.search(
            r"""
            \bSELECT\b
            (.*)$
            """,
            sql,
            re.IGNORECASE | re.DOTALL | re.VERBOSE
        )

        if not select_match:
            raise ValueError("SELECT clause not found in INSERT INTO")

        select_statement = "SELECT" + select_match.group(1)

        return target_name, column_dict, select_statement.strip()

    # -------------------------------------------------
    # Unsupported SQL
    # -------------------------------------------------
    raise ValueError("SQL is neither CREATE VIEW nor INSERT INTO")
