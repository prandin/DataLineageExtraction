def process_dst_group(cfarri_folder, dst_name, dst_df):
    error_log = []
    cfarri_csv_name = ""

    if pd.isna(dst_name) or isinstance(dst_name, int) or isinstance(dst_name, float):
        return dst_df, error_log

    if len(dst_name.split(".")) <= 1:
        error_log.append(
            f"\nNo dot character found in the dst_name string. DST Name: {dst_name}\n"
        )
        return dst_df, error_log

    try:
        cfarri_csv_name = os.path.join(
            os.path.abspath(cfarri_folder),
            dst_name.split(".")[1] + "_TRANSPOSE.csv"
        )

        df2 = pd.read_csv(cfarri_csv_name, dtype=str).fillna("")

        result_df = pd.merge(
            dst_df,
            df2,
            left_on="AXIOM_KEY",
            right_on="CR_FINAL_ATTRIBUTE",
            how="left",
            suffixes=("", "")
        )

        no_match = result_df[result_df["CF_FINAL_ATTRIBUTE"].isna()]
        missing_columns = no_match["AXIOM_KEY"].unique().tolist()

        if len(missing_columns) > 0:
            error_log.append("\nHere are the missing column list:\n")

            for col in missing_columns:
                error_log.append(col + "\n")

        return result_df, error_log

    except FileNotFoundError:
        print(f"\nFile not found: {cfarri_csv_name}\n")

        error_log.append(f"\nFile not found: {cfarri_csv_name}\n")
        error_log.append(
            f"\nDST Name not found in the cfarri directory: {dst_name}\n"
        )

        return dst_df, error_log

    except Exception as e:
        print(f"\nerror found: {e}\n")

        error_log.append(f"\nerror found: {e}\n")

        return dst_df, error_log


def merge_cfarri_axiom(df1, error_file, cfarri_folder):

    dst_df_grp = df1.groupby("AX_DST", dropna=False)

    with ThreadPoolExecutor() as executor:

        futures = {
            executor.submit(
                process_dst_group,
                cfarri_folder,
                dst_name,
                dst_df
            ): dst_name
            for dst_name, dst_df in dst_df_grp
        }

        merged_df_list = []
        error_log = []

        for future in concurrent.futures.as_completed(futures):

            df, errors = future.result()

            merged_df_list.append(df)

            error_log.extend(errors)

    with open(error_file, "w") as file:
        file.writelines(error_log)

    merged_df = pd.concat(merged_df_list, ignore_index=True)

    return merged_df


def reorder_df_by_columns_hierarchy(unordered_df):
    """
    Reorders columns in a DataFrame such that child columns
    immediately follow their parent columns.

    Parent column example:
        CF_SRC_TGT_TRANSFORMATION_1

    Child column example:
        CF_SRC_TGT_TRANSFORMATION_1_A
    """

    df = unordered_df

    original_cols = df.columns.tolist()

    new_cols = []

    used = set()

    prefix = "CF_SRC_TGT_TRANSFORMATION_"

    for col in original_cols:

        if col in used:
            continue

        new_cols.append(col)

        used.add(col)

        if col.startswith(prefix):

            suffix = col[len(prefix):]

            if suffix.isdigit():

                children_prefix = col + "_"

                children = [
                    c for c in original_cols
                    if c.startswith(children_prefix)
                    and c not in used
                ]

                children.sort()

                new_cols.extend(children)

                used.update(children)

    for col in original_cols:

        if col not in used:
            new_cols.append(col)

    ordered_df = df[new_cols]

    return ordered_df


def create_large_excel_file2_old(
        df,
        filename,
        chunk_size=50000
):

    print("record count:", len(df))

    with pd.ExcelWriter(
            filename,
            engine='xlsxwriter',
            engine_kwargs={
                'options': {
                    'constant_memory': True,
                    'zip64': True
                }
            }
    ) as writer:

        writer.book.use_zip64()

        for start in range(0, len(df), chunk_size):

            end = min(start + chunk_size, len(df))

            print(f"Rows added: {end}")

            chunk_df = df[start:end]

            chunk_df.to_excel(
                writer,
                startrow=start,
                header=(start == 0),
                index=False
            )

    return


def create_large_excel_file2(
        df,
        filename,
        chunk_size=50000
):

    max_excel_rows = 1000000

    total_rows = len(df)

    print("total_rows:", total_rows)

    with pd.ExcelWriter(
            filename,
            engine='xlsxwriter',
            engine_kwargs={
                'options': {
                    'constant_memory': True,
                    'zip64': True
                }
            }
    ) as writer:

        writer.book.use_zip64()

        sheet_index = 1

        sheet_row_count = 0

        sheet_name = f'Sheet{sheet_index}'

        header_written = False

        for start in range(0, total_rows, chunk_size):

            end = min(start + chunk_size, total_rows)

            chunk_df = df[start:end]

            print(f"Rows added: {end}")

            if sheet_row_count + len(chunk_df) > max_excel_rows:

                sheet_index += 1

                sheet_row_count = 0

                sheet_name = f'Sheet{sheet_index}'

                header_written = False

            chunk_df.to_excel(
                writer,
                sheet_name=sheet_name,
                startrow=sheet_row_count,
                header=not header_written,
                index=False
            )

            sheet_row_count += len(chunk_df)

            header_written = True

            print(
                f"{sheet_name}: Rows {start} to {end - 1} "
                f"written at Excel row {sheet_row_count}"
            )

    print("Excel file created successfully without losing any rows.")

    return


def split_df_to_xlsx_chunks(
        df,
        file_name,
        batch_size=50000
):
    """
    Splits a DataFrame into multiple Excel files
    with 1 million rows max per file.
    """

    df = df.fillna("")

    total_rows = len(df)

    rows_per_file = 1000000

    total_files = math.ceil(total_rows / rows_per_file)

    file_name = file_name.replace(".xlsx", "").replace(".csv", "").strip(".")

    print(f"Total rows: {total_rows}")

    print(f"Total files: {total_files}")

    for file_num in range(total_files):

        start_row = file_num * rows_per_file

        end_row = min(start_row + rows_per_file, total_rows)

        chunk_df = df.iloc[start_row:end_row].reset_index(drop=True)

        output_filename = (
            f"{file_name}_{file_num + 1}_of_{total_files}.xlsx"
        )

        file = output_filename.split("\\")[-1]

        print(f"Writing: {file}")

        with pd.ExcelWriter(
                output_filename,
                engine='xlsxwriter',
                engine_kwargs={
                    'options': {
                        'zip64': True
                    }
                }
        ) as writer:

            writer.book.use_zip64()

            worksheet = writer.book.add_worksheet("Sheet1")

            writer.sheets["Sheet1"] = worksheet

            for col_num, col_name in enumerate(chunk_df.columns):

                worksheet.write(0, col_num, col_name)

            for batch_start in range(
                    0,
                    len(chunk_df),
                    batch_size
            ):

                batch_end = min(
                    batch_start + batch_size,
                    len(chunk_df)
                )

                batch = chunk_df.iloc[batch_start:batch_end]

                cleaned_batch = (
                    batch.replace(
                        [float("inf"), float("-inf")],
                        pd.NA
                    ).fillna("")
                )

                data_rows = cleaned_batch.values.tolist()

                print(
                    f"Writing Batch: "
                    f"{batch_start} to {batch_end}"
                )

                for row_num, row_data in enumerate(
                        data_rows,
                        start=batch_start + 1
                ):

                    worksheet.write_row(
                        row_num,
                        0,
                        row_data
                    )

        print(f"Saved: {output_filename}")


